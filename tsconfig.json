{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es2020",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "moduleResolution": "node" // ⬅️ AGREGAR ESTA LÍNEA
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}